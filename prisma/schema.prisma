// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Student {
  id             Int          @id @default(autoincrement())
  registerNumber String       @unique
  studentName    String
  email          String       @unique
  password       String       @default("")
  department     String
  year           String
  section        String
  profilePhotoUrl String?
  profilePhotoPublicId String?
  studentType    String       @default("REGULAR") // "REGULAR" | "LATERAL_ENTRY"
  barcodeValue String?      @unique
  createdAt    DateTime     @default(now())
  attendances  Attendance[]
  emailLogs    EmailLog[]
  materials    CollegeMaterial[]
  examMarks    ExamMark[]
  academicRecords SemesterAcademicRecord[]
  scanLogs     BarcodeScanLog[]

  @@index([registerNumber])
  @@index([department, year, section])
  @@index([studentType])
  @@index([barcodeValue])
}

model BarcodeScanLog {
  id                     Int      @id @default(autoincrement())
  studentId              Int
  studentNameSnapshot    String
  registerNumberSnapshot String
  yearSnapshot           String
  sectionSnapshot        String
  departmentSnapshot     String
  barcodeValue           String?
  profilePhotoSnapshot   String?
  purpose                String   @default("Material Issue")
  materialsSnapshot      String   @default("[]")
  handledBy              String?  @default("Staff")
  note                   String?
  scannedAt              DateTime @default(now())
  createdAt              DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([scannedAt])
  @@index([registerNumberSnapshot])
  @@index([yearSnapshot, sectionSnapshot])
}

model CollegeMaterial {
  id           Int      @id @default(autoincrement())
  studentId    Int
  materialName String
  quantity     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialName])
  @@index([studentId])
}

model ExamMark {
  id            Int      @id @default(autoincrement())
  studentId     Int
  examCategory  String   // "CIA 1", "CIA 2", "Model Exam"
  subject       String
  obtainedMarks Float
  totalMarks    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examCategory, subject])
  @@index([studentId, examCategory])
}

model SemesterAcademicRecord {
  id             Int      @id @default(autoincrement())
  studentId      Int
  semester       Int      // 1 to 8
  sgpa           Float
  totalCredits   Float
  creditsEarned  Float
  arrearsCount   Int      @default(0)
  arrearsCleared Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester])
  @@index([studentId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  date      DateTime
  period    Int      @default(1)
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
  @@index([status])
  @@index([date, status])
}

model EmailLog {
  id           Int      @id @default(autoincrement())
  studentId    Int
  email        String
  percentage   Float
  subject      String
  body         String
  warningMonth String?  // Format: YYYY-MM
  sentAt       DateTime @default(now())
  status       String   // "Sent" or "Simulated" or "Failed"

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, warningMonth])
  @@index([studentId, warningMonth])
}

model SmtpSettings {
  id                    Int     @id @default(1)
  host                  String  @default("smtp.gmail.com")
  port                  Int     @default(587)
  secure                Boolean @default(false)
  user                  String  @default("")
  password              String  @default("")
  senderName            String  @default("College Attendance Portal")
  senderEmail           String  @default("")
  lowThreshold          Float   @default(75.0)
  collegeOpeningDate    String  @default("2026-07-13")
  lastMonthlyWarningRun String?
}

model Teacher {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  department String   @default("CSE")
  createdAt  DateTime @default(now())
}
